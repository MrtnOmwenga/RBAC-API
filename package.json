{
  "name": "rbac-api",
  "version": "2.0.0",
  "description": "Multi-tenant role-based access control API: NestJS, PostgreSQL row-level security, policy-as-data, audit log",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "migrate": "node dist/database/migrate.js",
    "migrate:dev": "tsx --env-file-if-exists=.env src/database/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e",
    "test:all": "jest",
    "test:mutation": "stryker run",
    "policy:table": "tsx scripts/policy-table.ts",
    "build:web": "npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@hocuspocus/server": "^4.7.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.17",
    "lib0": "^0.2.118",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hocuspocus/provider": "^4.7.0",
    "@nestjs/cli": "^12.0.8",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0"
  }
}
