# Local development. For the Docker stack, see README (Run it): it writes a .env with random values.

# The API connects as a least-privilege role; row-level security applies to it.
DATABASE_URL=postgres://rbac_app_login:<app-db-password>@localhost:5432/rbac
# Migrations run as the database owner (needs BYPASSRLS, e.g. the compose superuser).
MIGRATION_DATABASE_URL=postgres://postgres:<postgres-password>@localhost:5432/rbac
# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
PORT=3000
LOG_LEVEL=info
# The public "Redacted" demo (throwaway agencies at POST /demo/sessions, UI at /)
DEMO_MODE=true

# Used by docker-compose.yml
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
